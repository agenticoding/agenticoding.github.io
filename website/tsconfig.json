{
  // This file is not used in compilation. It is here just for a nice editor experience.
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    // The star band imports the build-time snapshot JSON directly; tsc must
    // resolve it (scripts/fetch-github-stars.js generates it).
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": [
      "@docusaurus/module-type-aliases",
      "@docusaurus/types",
      // Ambient @theme/* declarations (swizzled component Props) ship with
      // theme-classic; without this entry tsc cannot resolve @theme imports.
      "@docusaurus/theme-classic"
    ]
  },
  "include": ["src/**/*", "docs/**/*", "*.ts"],
  "exclude": [".docusaurus", "build", "node_modules"]
}
